{
  "screen": { "width": 1280, "height": 720, "orientation": "landscape", "driverSide": "right" },
  "color": {
    "background": "#0E0F12",
    "glowNeutral1": "#2A2C33",
    "glowNeutral2": "#1D1E24",
    "text": { "primary": "#F2F3F5", "secondary": "#C8CAD1", "muted": "#B3B5BD", "faint": "#9A9CA5" },
    "glass": {
      "fill": "rgba(255,255,255,0.06)",
      "border": "rgba(255,255,255,0.14)",
      "highlight": "rgba(255,255,255,0.16)",
      "shadow": "0 16 48 rgba(4,4,8,0.45)",
      "blurRadius": 28
    },
    "tile": { "fill": "rgba(255,255,255,0.07)", "border": "rgba(255,255,255,0.10)" },
    "danger": "#C62828",
    "success": "#34D399",
    "warning": "#FBBF24"
  },
  "themes": {
    "Violet": { "accent": "#7C5CFF", "glow": "#3B3368", "wallpaper": "assets/wallpapers/wall-Violet.webp", "default": true },
    "Ocean": { "accent": "#2563EB", "glow": "#1F3D73", "wallpaper": "assets/wallpapers/wall-Ocean.webp" },
    "Emerald": { "accent": "#047857", "glow": "#0F4A3F", "wallpaper": "assets/wallpapers/wall-Emerald.webp" },
    "Rose": { "accent": "#BE185D", "glow": "#5A1F45", "wallpaper": "assets/wallpapers/wall-Rose.webp" }
  },
  "iconGradients": {
    "blue": ["#8FB3FF", "#3D5AFE"],
    "violet": ["#D4B8FF", "#7C5CFF"],
    "teal": ["#8FF5DF", "#1FAE9F"],
    "sun": ["#FFE7A0", "#FFB547"],
    "frost": ["rgba(255,255,255,0.88)", "rgba(220,214,255,0.42)"],
    "dot": ["#A9FFF0", "#2BC4B4"]
  },
  "radius": { "panel": 28, "card": 22, "tile": 16, "button": 14, "pill": 999 },
  "spacing": { "screenPadding": 24, "panelGap": 20, "rowGap": 12, "railWidth": 88 },
  "type": {
    "display": { "family": "Barlow Semi Condensed", "weights": [500, 600] },
    "body": { "family": "Manrope", "weights": [400, 500, 600] },
    "sizes": { "clockHuge": 200, "title": 34, "cardTitle": 26, "body": 17, "label": 15, "caption": 12 }
  },
  "motion": {
    "press": { "scale": 0.95, "durationMs": 220 },
    "enter": { "translateDp": 14, "durationMs": 600, "staggerMs": 80 },
    "toggle": { "durationMs": 380, "overshoot": true },
    "tabIndicator": { "durationMs": 450, "overshoot": true },
    "wheelLoaderMs": 750,
    "recordSpinSecondsPerTurn": 7,
    "carSpin": { "frames": 72, "fps": 12 },
    "toastMs": 2200
  },
  "clock": { "format": "h:mm a" },
  "homeLayouts": ["Dashboard", "Car showcase", "Minimal", "Drive focus"],
  "appSections": {
    "Drive": ["Maps", "Weather"],
    "Media": ["Music", "Radio", "Camera", "Video", "Gallery"],
    "Connect": ["Phone", "CarPlay / Android Auto", "Bluetooth"],
    "Tools": ["Files", "Browser", "App store", "Calculator", "Clock"],
    "System": ["Equalizer", "Settings", "Car settings"]
  },
  "credits": [
    "Car 3D model: \"Toyota Noah\" by Nieve5677 (Sketchfab), CC Attribution",
    "Fonts: Barlow Semi Condensed and Manrope, SIL Open Font License"
  ]
}
